[Unit]
Description=InterbotixControlServer FastAPI Application

[Service]
Type=simple
WorkingDirectory=%h/InterbotixControlServer
Environment=PYTHONPATH=%h/InterbotixControlServer
Environment=ROS_DISTRO=jazzy
ExecStart=/usr/bin/bash %h/InterbotixControlServer/scripts/run-server.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
